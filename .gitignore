# FreeLinX/toolchain - bundled / extracted artifacts. Never commit these.

# Extracted toolchain binaries (the LLVM host tools, ~3.7 GB). These are
# provided by the FreeLinX toolchain release, not tracked in this repo.
/bin/

# Downloaded / release archive artifacts.
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tar.xz
*.zip

# Build / extraction output directories.
/build/

# Generated by git fetch; not source.
FETCH_HEAD

# Extracted/generated LLVM toolchain installation trees (headers, static and
# shared libraries, support scripts, docs). Like /bin/, these are produced by
# the toolchain release build and are not tracked source; never commit them.
/include/
/lib/
/libexec/
/share/

# The musl sysroot extracted next to the LLVM tools.
/x86_64-linux-musl/

# Throwaway bring-up / verification scratch files; not part of the repo.
/test.cpp
/test_output

# Developer convenience wrapper shims that hard-code a stale $HOME path;
# kept out of the repo to avoid committing unverified configuration.
/env.sh
/freelinix-ar
/freelinix-c++
/freelinix-cc
/freelinix-nm
/freelinix-ranlib
/freelinix-strip
